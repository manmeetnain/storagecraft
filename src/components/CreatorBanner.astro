---
const profile = 'https://github.com/manmeetnain';
const repository = 'https://github.com/manmeetnain/storagecraft';
---

<aside class="creator-banner" aria-label="StorageCraft creator and repository" data-pagefind-ignore>
  <div class="identity">
    <span class="signal" aria-hidden="true"></span>
    <a href={profile}><strong>Manmeet Nain</strong> · @manmeetnain</a>
  </div>
  <div class="repo-actions">
    <span>CREATOR · MAINTAINER</span>
    <a href={repository}>Repository ↗</a>
  </div>
</aside>

<style>
  .creator-banner{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem clamp(1rem,4vw,2.25rem);background:linear-gradient(90deg,#edf8fa,#f5f2fc 58%,#fff5f8);border-bottom:1px solid rgba(35,121,145,.18);color:#4b6178;font:700 .72rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.02em}
  .identity,.repo-actions{display:flex;align-items:center;gap:.65rem}.signal{width:.5rem;height:.5rem;border-radius:50%;background:#20a773;box-shadow:0 0 .8rem rgba(32,167,115,.42)}.creator-banner a{color:#087f9b;text-decoration:none}.creator-banner a:hover{text-decoration:underline;color:#123d55}.repo-actions span{color:#65798e;font-size:.63rem;letter-spacing:.12em}.repo-actions a{padding:.38rem .65rem;border:1px solid rgba(24,128,153,.22);border-radius:.5rem;background:rgba(255,255,255,.72)}
  @media(max-width:50rem){.repo-actions span{display:none}.creator-banner{padding-inline:1rem}.identity{flex-wrap:wrap}}
</style>
