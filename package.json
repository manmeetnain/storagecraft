{
  "name": "storagecraft",
  "version": "0.1.0",
  "description": "The open knowledge base for storage systems and AI infrastructure.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "gen:bench": "python3 scripts/gen_benchmark_page.py",
    "gen:index": "python3 scripts/gen_content_index.py",
    "validate": "python3 scripts/validate_frontmatter.py",
    "validate:capsules": "node scripts/validate_capsules.mjs",
    "validate:brand": "node scripts/validate_brand.mjs",
    "craft": "node scripts/storagecraft.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:academy:e2e": "npm run test:e2e",
    "check": "npm run validate && npm run validate:brand && npm run validate:capsules && npm test && npm run build"
  },
  "bin": {
    "storagecraft": "./scripts/storagecraft.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.7",
    "sharp": "^0.32.5"
  },
  "keywords": [
    "storage",
    "distributed-systems",
    "filesystems",
    "nvme",
    "raid",
    "lsm-tree",
    "ai-infrastructure",
    "llm",
    "benchmarks",
    "open-source"
  ],
  "license": "MIT",
  "author": {
    "name": "Manmeet Nain",
    "email": "manmeet.nain@gmail.com",
    "url": "https://github.com/manmeetnain"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manmeetnain/storagecraft"
  },
  "homepage": "https://manmeetnain.github.io/storagecraft",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  }
}
